	(text "INFO: Charger SYS+ output only supports 6A continuous/10A peak but we need 20A (for the HCOs). \nThat's why we don't use it and connect the main voltage directly to the battery instead. \nBAT+ will however most likely behave weirdly when no batteries are attached.\nTo have a second option, we could add this optional MOLEX to SYS+.\nThen we could at least use main_voltage even with no batteries attached."
		(exclude_from_sim no)
		(at 193.04 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e541a3c9-ff98-4237-8ad4-375e4183a2a9")
	)
